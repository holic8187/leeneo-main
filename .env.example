# Server
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/working_ineo
JWT_SECRET=

# Standalone TCG accounts
TCG_JWT_SECRET=
# Leave empty to keep the device signed in until its token is explicitly revoked.
TCG_JWT_EXPIRES_IN=

# TCG administrator credentials are server-only. Generate the password hash
# with bcrypt and never place the plaintext password in this file or VITE_*.
TCG_ADMIN_USERNAME=
TCG_ADMIN_PASSWORD_HASH=
# Optional. When empty, TCG_JWT_SECRET is used with a separate admin audience.
TCG_ADMIN_JWT_SECRET=

# Set to the number of trusted reverse-proxy hops in production (commonly 1
# for a single managed HTTPS proxy). Leave empty when connecting directly.
TRUST_PROXY_HOPS=
