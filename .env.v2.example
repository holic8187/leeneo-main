# Use a database separate from the live V1 database.
V2_MONGO_URI=mongodb+srv://USER:PASSWORD@HOST/ineo_v2_test
V2_TEST_PORT=5001
JWT_SECRET=replace-with-a-test-secret
TCG_JWT_SECRET=replace-with-a-separate-tcg-secret
# Leave empty to keep the device signed in until its token is explicitly revoked.
TCG_JWT_EXPIRES_IN=
TRUST_PROXY_HOPS=
