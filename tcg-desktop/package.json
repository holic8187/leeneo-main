{
  "name": "hoi-card-desk",
  "version": "0.3.0",
  "private": true,
  "description": "A discreet desktop card collection game linked optionally to Hoi Company.",
  "author": "Hoi Company",
  "type": "module",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "concurrently -k -n WEB,DESKTOP -c cyan,green \"pnpm run dev:web\" \"pnpm run dev:electron\"",
    "dev:web": "vite --host 127.0.0.1 --port 1420",
    "dev:electron": "wait-on tcp:127.0.0.1:1420 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:1420 electron .",
    "test": "node --test test/*.test.js",
    "build:web": "vite build",
    "build": "node --test test/*.test.js && vite build",
    "dist:win": "node --test test/*.test.js && vite build && node scripts/build-windows.cjs",
    "publish:win": "node --test test/*.test.js && vite build && node scripts/build-windows.cjs --publish"
  },
  "build": {
    "appId": "com.hoicompany.carddesk",
    "productName": "Hoi Company Card Desk",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "icon": "public/assets/app-icon.ico",
    "artifactName": "Hoi-Card-Desk-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hoi Card Desk"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "holic8187",
        "repo": "leeneo-main",
        "tagNamePrefix": "tcg-v",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide": "^1.41.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
