# TCG account API. Use the public HTTPS origin in production.
VITE_TCG_API_BASE=http://127.0.0.1:5000

# Optional iPhone distribution. Leave empty for Personal Team/development builds.
# Use your registered App Store numeric ID, or your app's actual TestFlight invitation.
# A TestFlight invitation takes precedence over the public App Store listing.
VITE_TCG_IOS_APP_STORE_ID=
VITE_TCG_IOS_TESTFLIGHT_URL=
